@model AndtrWeb.Models.SharedReview
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Comments - @Model.Name</title>
    <link rel="stylesheet" href="~/css/customer.css" />
</head>
<body>
<header class="topbar">
    <strong>Medical Safety Platform</strong>
    <nav><a href="#">Profile</a> | <a href="#">Logout</a></nav>
</header>

<nav class="breadcrumb">
    <a asp-controller="Customer" asp-action="Dashboard">Dashboard</a> &gt;
    <a asp-controller="Customer" asp-action="Dashboard">Shared Findings</a> &gt;
    <span>Comments</span>
</nav>

<div class="page">
    <section class="panel">
        <p><b>Review:</b> @Model.Name</p>
        <p><b>Device:</b> @Model.DeviceName</p>
    </section>

    @if (TempData["Message"] is string ok)
    {
        <div class="alert success" role="status">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert error" role="alert">@err</div>
    }

    <section class="panel">
        <h2>Conversation</h2>

        @if (!Model.Comments.Any())
        {
            <p class="muted">No comments yet. Use the box below to ask a question.</p>
        }
        @foreach (var c in Model.Comments.OrderBy(c => c.Date))
        {
            <div class="comment @c.Role">
                <b>@c.Role</b> &mdash; <span class="muted">@c.Author, @c.Date.ToString("dd MMM yyyy HH:mm")</span>
                <p>@c.Text</p>
            </div>
        }
    </section>

    <section class="panel">
        <h2>Add a Comment</h2>

        @if (Model.CanComment)
        {
            <form asp-controller="Customer" asp-action="AddComment" asp-route-id="@Model.Id" method="post">
                <textarea name="text" rows="4" maxlength="1000" placeholder="Type your question or comment here..." required></textarea>
                <div class="form-actions">
                    <button type="reset" class="btn secondary">Cancel</button>
                    <button type="submit" class="btn">Send Comment</button>
                </div>
            </form>
        }
        else
        {
            <div class="notice">
                Commenting is unavailable for this review because it has expired
                @if (Model.AccessExpires.HasValue)
                {
                    <text>(access ended on @Model.AccessExpires.Value.ToString("dd MMM yyyy"))</text>
                }
                or has been withdrawn. Please contact support if you still have questions.
            </div>
        }
    </section>

    <section class="panel actions">
        @if (Model.Status == "Available")
        {
            <a class="btn" asp-controller="Customer" asp-action="Details" asp-route-id="@Model.Id">Back to Review Details</a>
        }
        else
        {
            <a class="btn" asp-controller="Customer" asp-action="Dashboard">Back to Shared Findings</a>
        }
    </section>
</div>

<footer>
    <a href="#">Help</a> | <a href="#">Privacy</a> | <a href="#">Contact Support</a>
</footer>
</body>
</html>